# Plantilla de ~/.config/cabritos.env
#
# Copiala asi:
#   mkdir -p ~/.config
#   cp herramientas/cabritos.env.ejemplo ~/.config/cabritos.env
#   chmod 600 ~/.config/cabritos.env
# y despues reemplaza los tres valores.
#
# De donde salen los tres datos:
#   Abre la app -> MAS -> NUBE (SUPABASE). Ahi estan los tres tal cual.
#   O en supabase.com -> tu proyecto -> Settings -> API:
#     Project URL  -> SUPABASE_URL
#     anon public  -> SUPABASE_KEY
#   El codigo de casa lo elegiste tu al conectar la nube en la app.
#
# NUNCA subas este archivo a git: la anon key da acceso de lectura y escritura
# a todo lo que hay en la tabla kv de tu proyecto.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...pega-aqui-tu-anon-key-completa
HOUSE=tu-codigo-de-casa
